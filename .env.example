# Site URL used for canonical links, sitemap, and OG metadata.
# Update this after claiming a custom domain and redeploy.
NEXT_PUBLIC_SITE_URL=https://stickerly1.vercel.app

# Gumroad API credentials (optional but recommended).
# When GUMROAD_TOKEN is set, /api/gumroad will use the authenticated Gumroad
# API v2 to fetch product details instead of public-page scraping.
# Generate an access token in your Gumroad Settings > Advanced > Applications.
GUMROAD_TOKEN=
GUMROAD_APP_ID=
GUMROAD_APP_SECRET=
OPENROUTER_API_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
