# Site URL used for canonical links, sitemap, and OG metadata.
# Update this after claiming a custom domain and redeploy.
NEXT_PUBLIC_SITE_URL=https://stickerly1.vercel.app

# Gumroad API credentials (optional but recommended).
# When GUMROAD_ACCESS_TOKEN is set, /api/gumroad will use the authenticated
# Gumroad API v2 to fetch product details instead of public-page scraping.
# Generate an access token in your Gumroad Settings > Advanced > Applications.
GUMROAD_ACCESS_TOKEN=
GUMROAD_APP_ID=
GUMROAD_APP_SECRET=

# Gumroad product IDs (the permalink slug from each product URL).
# WARNING: The values below are placeholders. They currently resolve to other
# creators' Gumroad listings, so direct-buy and checkout buttons will show
# "Coming soon" until you replace them with your own Gumroad offer IDs and
# redeploy.
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_CUTE_STICKER_PACK=cute-sticker-pack
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_MOTION_UI_KIT=motion-ui-kit
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_3D_ICON_SCENE=3d-icon-scene
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_KAWAII_ANIMALS=kawaii-animals
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_LOADER_COLLECTION=loader-collection
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_FLOATING_SHAPES=floating-shapes
NEXT_PUBLIC_GUMROAD_PRODUCT_ID_STICKERS1=fghoyf
